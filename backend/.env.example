# ---------------------------------------------------------------------------
# U APP server configuration. Copy to .env and set real values in your host.
# Only Firebase client config stays here (it must be baked at build time).
# Everything else (UPI ID, OTP settings, GitHub build config, pricing, rate
# limits) is set from the Admin Panel after deploy and stored in Firestore.
# ---------------------------------------------------------------------------
PORT=3000
APP_URL=https://your-domain.example

# Firebase client config (safe for browsers)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin (server only - never expose to the browser)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Admin bootstrap (whoever enters this code while logged in becomes an admin)
ADMIN_SETUP_KEY=
